<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tomlyn.Extensions.Configuration\Tomlyn.Extensions.Configuration.csproj"
                      GlobalPropertiesToRemove="PublishAot" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.toml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings_with_underscores.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
